# Copy this file to .env and fill it in. Never commit .env; .gitignore excludes it.

# fake = no API call (use this for the setup check)
# anthropic or openai = real provider (pick one after the SP-1 feasibility check)
AI_PROVIDER=fake

# Model name from your provider's documentation. Required unless AI_PROVIDER=fake.
AI_MODEL=

# Your own API key. Stays on the server; never paste it into app.js or a commit.
AI_API_KEY=
